{
  "name": "svelte-highlight",
  "version": "7.23.1",
  "license": "MIT",
  "description": "Svelte component library for highlighting code using highlight.js",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "build:lib": "bun scripts/index.ts && bun format",
    "package": "bun scripts/npm-package.ts",
    "test:unit": "bun test tests/*.ts",
    "test:e2e": "bunx playwright test",
    "test:static-app": "bun run build:lib && bun run package && cd tests/e2e/static-app && bun install && bun run test",
    "test:types": "tsgo",
    "bench": "ostia bench bench/*.bench.ts",
    "bench:ab": "ostia ab --base-setup \"bun scripts/index.ts\"",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "fix:changed": "biome check --write --changed --since=master --no-errors-on-unmatched .",
    "upgrade-examples": "bun scripts/upgrade-examples.ts",
    "astro": "astro",
    "playwright": "playwright"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@biomejs/biome": "2.6.3",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/experimental-ct-svelte": "1.58.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/bun": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "astro": "^7.4.2",
    "carbon-components-svelte": "^0.113.1",
    "carbon-preprocess-svelte": "^0.11.58",
    "cssnano": "^9.9.0",
    "cssnano-preset-lite": "^6.0.11",
    "highlight.js": "11.12.0",
    "ostia": "^0.2.12",
    "postcss": "^8.5.31",
    "postcss-discard-duplicates": "^9.0.7",
    "postcss-inline-css-vars": "^0.1.0",
    "postcss-merge-rules": "^9.1.5",
    "svelte": "^5.57.2",
    "vite": "^7.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-highlight.git"
  },
  "homepage": "https://svhe.onrender.com/",
  "bugs": "https://github.com/metonym/svelte-highlight/issues",
  "keywords": [
    "svelte",
    "svelte components",
    "highlight.js",
    "syntax highlight"
  ]
}
